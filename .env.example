# PostgreSQL (자체 호스팅 — docker compose의 postgres 컨테이너)
# 호스트에서 backend를 직접 실행(bootRun)할 때의 접속 주소. 컨테이너 안에서는 compose가 DB_URL을 덮어쓴다.
DB_URL=jdbc:postgresql://localhost:5432/growant
DB_USER=growant
DB_PASSWORD=growant

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# AI (Gemini)
GEMINI_API_KEY=__change_me__

# Auth
JWT_SECRET=__change_me__

# Social OAuth (placeholder)
KAKAO_CLIENT_ID=
NAVER_CLIENT_ID=
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Market data source: sim | kis
MARKET_PROVIDER=sim
# 분봉 수집은 라이선스와 운영 안전 조건을 확인한 뒤 명시적으로 활성화한다.
# 생략하면 MARKET_PROVIDER 값을 사용한다. 공급자와 다른 출처명이 필요할 때만 지정한다.
# MARKET_CANDLE_SOURCE=sim
MARKET_CANDLE_COLLECTION_ENABLED=false
MARKET_CANDLE_TRACKED_TICKERS=005930,000660,035720,035420,005380
MARKET_CANDLE_FINALIZATION_DELAY=5s
MARKET_CANDLE_SCHEDULER_INTERVAL=1s
MARKET_CANDLE_MAX_QUERY_RANGE=7d
MARKET_CANDLE_ZONE_ID=Asia/Seoul
